# Copy these values into your shell environment. Never commit a real API key.
REPOFIX_BASE_URL=https://api.deepseek.com
REPOFIX_API_KEY=replace-me
REPOFIX_MODEL=deepseek-v4-flash
REPOFIX_MAX_STEPS=12
REPOFIX_MAX_CONTEXT_CHARS=24000
REPOFIX_REQUEST_TIMEOUT_SECONDS=45
REPOFIX_MAX_REQUESTS=0
REPOFIX_MAX_TOKENS=0
# Set these when using a paid provider; zero disables cost estimation.
REPOFIX_INPUT_COST_PER_MILLION=0.44
REPOFIX_OUTPUT_COST_PER_MILLION=1.32
REPOFIX_CACHED_INPUT_COST_PER_MILLION=0.014
REPOFIX_MAX_IDENTICAL_ACTIONS=2
REPOFIX_MAX_CHANGED_FILES=5
REPOFIX_ROLLBACK_ON_FAILURE=0
# Harness-owned baseline/final verification; only pytest commands are accepted.
REPOFIX_TEST_COMMAND=pytest -q
REPOFIX_EXECUTION_BACKEND=local
REPOFIX_DOCKER_IMAGE=repofix-pytest:latest
REPOFIX_COMMAND_TIMEOUT_SECONDS=30
REPOFIX_MAX_OUTPUT_TOKENS=2048
REPOFIX_SEED_FAILURE_CONTEXT=1
